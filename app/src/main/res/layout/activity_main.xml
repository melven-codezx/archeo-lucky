<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= HUD do saldo (canto superior) ================= -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/hud_background"
        android:elevation="10dp"
        android:minWidth="196dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/saldo_label"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <View
                android:id="@+id/liveDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/live_dot" />

            <TextView
                android:id="@+id/liveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:text="@string/status_offline"
                android:textColor="@color/muted"
                android:textSize="9sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/saldoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/saldo_empty"
            android:textColor="@color/gold"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif"
            android:text="@string/app_name"
            android:textColor="#FF5A5A68"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- ================= Janela flutuante de configuração ================= -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="86dp"
        android:background="@drawable/panel_background"
        android:elevation="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Cabeçalho (arraste para mover) -->
        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="8dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="@string/panel_title"
                android:textColor="@color/gold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/panelSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/stepper_button"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="—"
                android:textColor="@color/gold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/stepper_button"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/muted"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Corpo (some quando minimiza) -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <!-- Stake -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="@string/label_stake"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnStakeMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/stepper_button"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/gold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/stakeValue"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_background"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="1,00 FUN"
                    android:textColor="#FFF2F2F5"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnStakePlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/stepper_button"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/gold"
                    android:textSize="18sp" />

            </LinearLayout>


            <!-- ===== MINAS (Mi Mines) ===== -->
            <LinearLayout
                android:id="@+id/rowMines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_mines"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMinesMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/minesValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="3 minas"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnMinesPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ===== CLIQUES POR SESSÃO (Archéo / Mi Mines) ===== -->
            <LinearLayout
                android:id="@+id/rowClicks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_clicks"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnClicksMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/clicksValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="3 cliques"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnClicksPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ===== MARTINGALE (Mi Mines / Archéo) ===== -->
            <LinearLayout
                android:id="@+id/rowGale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/label_gale"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/btnGale"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/gale_on"
                        android:textColor="@color/green"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_mult"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMultMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="\u2212"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/multValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="×2,00"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnMultPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/label_limite"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/btnSemLimite"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:minWidth="72dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/sem_limite_off"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnLimitMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="\u2212"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/limitValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="3 gales"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnLimitPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== COPY TRADER (Aviator) ===== -->
            <LinearLayout
                android:id="@+id/rowCopy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_copy"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/copyInput"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:hint="@string/copy_hint"
                        android:inputType="textCapCharacters"
                        android:maxLength="8"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="#FFF2F2F5"
                        android:textColorHint="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnCopy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:minWidth="78dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/copy_start"
                        android:textColor="@color/gold"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/copyStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text=""
                    android:textColor="@color/muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- ===== ALVO / AUTO-CASHOUT (Aviator) ===== -->
            <LinearLayout
                android:id="@+id/rowAlvo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_alvo"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAlvoMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/alvoValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="2,00x"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnAlvoPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ===== REGRA DE ENTRADA (Aviator) ===== -->
            <LinearLayout
                android:id="@+id/rowRegra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_regra"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnRegra"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/field_background"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/regra_apos_baixa"
                    android:textColor="#FFF2F2F5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== NOMES (Aviator) ===== -->
            <LinearLayout
                android:id="@+id/rowNomes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_nomes"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnNomes"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/field_background"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="@string/nomes_anon"
                    android:textColor="#FFF2F2F5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== DELAY (Aviator - NetLimiter moderno) ===== -->
            <LinearLayout
                android:id="@+id/rowDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_delay"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDelayMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/delayValue"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/field_background"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="0 ms"
                        android:textColor="#FFF2F2F5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnDelayPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/stepper_button"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/gold"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- ===== COMPARAR (Aviator - janela sem delay) ===== -->
            <LinearLayout
                android:id="@+id/rowComparar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.1"
                    android:text="@string/label_comparar"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnAbrirReal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/btn_auto"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_abrir_real"
                    android:textColor="#FF0B0B0F"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status do automático -->
            <TextView
                android:id="@+id/autoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_background"
                android:fontFamily="sans-serif-medium"
                android:padding="9dp"
                android:text="@string/auto_idle"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <!-- Botão operação automática -->
            <TextView
                android:id="@+id/btnAuto"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_auto"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/auto_start"
                android:textColor="#FF0B0B0F"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnGoGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/go_google"
                android:textColor="@color/muted"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= Janela flutuante REAL (sem delay) ================= -->
    <LinearLayout
        android:id="@+id/windowReal"
        android:layout_width="340dp"
        android:layout_height="420dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="@drawable/panel_background"
        android:elevation="20dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/windowRealHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF1A1A2E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="@string/window_real_title"
                    android:textColor="@color/gold"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/window_real_sub"
                    android:textColor="@color/muted"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFecharReal"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/stepper_button"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/muted"
                android:textSize="13sp" />

        </LinearLayout>

        <WebView
            android:id="@+id/webviewReal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/realStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF0F0F1F"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="6dp"
            android:text="TEMPO REAL — sem delay"
            android:textColor="@color/green"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ================= Botão flutuante G (abre/fecha o painel) ================= -->
    <TextView
        android:id="@+id/btnGoogle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/fab_background"
        android:contentDescription="@string/go_google"
        android:elevation="8dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="G"
        android:textColor="#FF0B0B0F"
        android:textSize="22sp" />

</FrameLayout>
